{
  "manifest_version": 3,
  "name": "Auto-Youtube",
  "version": "1.0.0",
  "description": "Plays YouTube videos at your chosen quality, with optional autopause.",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Auto-Youtube",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "content_scripts": [
    { "matches": ["*://*.youtube.com/*"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": true },
    { "matches": ["*://*.youtube.com/*"], "js": ["main.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN" }
  ]
}
